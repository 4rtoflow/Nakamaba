{
  "name": "nakamaba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "synth": "cdk synth --quiet",
    "dev": "tsx scripts/dev-server.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "refresh-site": "tsx scripts/refresh-site.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "3.1161.0",
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-ssm": "3.1161.0",
    "@aws-sdk/lib-dynamodb": "3.1161.0",
    "@aws-sdk/s3-presigned-post": "3.1161.0",
    "marked": "18.1.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "4.1.12",
    "aws-cdk": "2.1147.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
